# Mac / editor cruft
.DS_Store
.idea/
.vscode/

# Minikube local state
.minikube/

# Terraform working directories
**/.terraform/*
!**/.terraform/.gitkeep

# Terraform state files (NEVER commit these)
*.tfstate
*.tfstate.*

# Terraform crash log
crash.log
crash.*.log

# Local variable files (might contain secrets)
*.tfvars.json
!example.tfvars

# CLI plan output
*tfplan*

# Init markers (justfile creates these per-env)
**/.tf_init_*

# Local credentials and tfvars overrides (if used)
*.auto.tfvars
*.auto.tfvars.json
